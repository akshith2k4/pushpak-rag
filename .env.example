# Copy to .env and fill in. .env is gitignored — never commit secrets.
# Neon Postgres (free tier). Get from Neon dashboard: connection string with ?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Upstash Redis REST (Phase 6 semantic cache, 24h TTL). Optional; degrades to
# uncached when unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Google AI (Gemini API) key for embeddings (gemini-embedding-2) and generation.
GOOGLE_API_KEY=
# Jev/TypeSafe key for steered reranking (Phase 3b+). Optional: retrieval
# falls back to RRF order when unset and rerank is off.
JEV_API_KEY=
# Embedding config: model + Matryoshka-truncated dims (must match vector(768) in db/schema.sql).
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMS=768
# Generation model (verified on this key; must support generateContent).
GEN_MODEL=gemini-2.5-flash
# Generation provider: gemini | groq. Groq uses OpenAI-compatible tools.
LLM_PROVIDER=gemini
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
